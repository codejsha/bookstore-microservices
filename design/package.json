{
  "name": "@bookstore/design",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./build/css/tokens.css"
  ],
  "exports": {
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./aria/*": {
      "types": "./dist/aria/*.d.ts",
      "import": "./dist/aria/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./native/*": "./components/native/*.tsx",
    "./tokens": "./build/css/tokens.css",
    "./tokens/ts/*": "./build/ts/*.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "build/css",
    "build/ts",
    "components/native"
  ],
  "publishConfig": {
    "registry": "https://nexus.example.com/repository/npm-hosted/",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsx scripts/build-tokens.ts && tsup",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "build:components": "tsup",
    "prepublishOnly": "tsx scripts/build-tokens.ts && tsup",
    "context": "tsx scripts/assemble-ai-context.ts",
    "check": "biome check --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react-aria-components": "^1.17.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nativewind": "^4.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "shadcn": "^4.2.0",
    "storybook": "^10.4.1",
    "style-dictionary": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-react-aria-components": "^2.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.8"
  }
}
