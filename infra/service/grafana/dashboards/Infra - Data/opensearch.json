{
  "title": "Bookstore — OpenSearch",
  "uid": "bookstore-opensearch",
  "tags": ["bookstore", "data", "opensearch"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(opensearch_cluster_status, namespace)",
        "current": {"text": "All", "value": "$__all"},
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(opensearch_cluster_status{namespace=~\"$namespace\"}, cluster)",
        "current": {"text": "All", "value": "$__all"},
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cluster",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cluster status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "GREEN", "color": "green"}, "1": {"text": "YELLOW", "color": "yellow"}, "2": {"text": "RED", "color": "red"}}}
          ],
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value", "graphMode": "none", "colorMode": "background"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(opensearch_cluster_status{namespace=~\"$namespace\", cluster=~\"$cluster\"})", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "graphMode": "area", "colorMode": "value"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(opensearch_cluster_nodes_number{namespace=~\"$namespace\", cluster=~\"$cluster\"})", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active shards",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "graphMode": "area", "colorMode": "value"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(opensearch_cluster_shards_active_number{namespace=~\"$namespace\", cluster=~\"$cluster\"})", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unassigned shards",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "graphMode": "area", "colorMode": "value"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(opensearch_cluster_shards_unassigned_number{namespace=~\"$namespace\", cluster=~\"$cluster\"})", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Pending tasks",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "graphMode": "area", "colorMode": "value"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(opensearch_cluster_pending_tasks_number{namespace=~\"$namespace\", cluster=~\"$cluster\"})", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total docs",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "graphMode": "area", "colorMode": "value"},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(opensearch_indices_doc_number{namespace=~\"$namespace\", cluster=~\"$cluster\"})", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Search & indexing",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Search rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (node) (rate(opensearch_indices_search_query_count{namespace=~\"$namespace\", cluster=~\"$cluster\"}[$__rate_interval]))", "legendFormat": "{{node}}", "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Search latency (avg)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(opensearch_indices_search_query_time_seconds{namespace=~\"$namespace\", cluster=~\"$cluster\"}[$__rate_interval]) / clamp_min(rate(opensearch_indices_search_query_count{namespace=~\"$namespace\", cluster=~\"$cluster\"}[$__rate_interval]), 1)", "legendFormat": "{{node}}", "refId": "A"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Indexing rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (node) (rate(opensearch_indices_indexing_index_count{namespace=~\"$namespace\", cluster=~\"$cluster\"}[$__rate_interval]))", "legendFormat": "{{node}}", "refId": "A"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Indexing latency (avg)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(opensearch_indices_indexing_index_time_seconds{namespace=~\"$namespace\", cluster=~\"$cluster\"}[$__rate_interval]) / clamp_min(rate(opensearch_indices_indexing_index_count{namespace=~\"$namespace\", cluster=~\"$cluster\"}[$__rate_interval]), 1)", "legendFormat": "{{node}}", "refId": "A"}
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Heap used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 23, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "opensearch_jvm_mem_heap_used_bytes{namespace=~\"$namespace\", cluster=~\"$cluster\"}", "legendFormat": "{{node}}", "refId": "A"}
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "GC time / sec",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 23, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (node, gc) (rate(opensearch_jvm_gc_collection_time_seconds{namespace=~\"$namespace\", cluster=~\"$cluster\"}[$__rate_interval]))", "legendFormat": "{{node}} / {{gc}}", "refId": "A"}
      ]
    }
  ]
}
