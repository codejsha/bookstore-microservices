          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_duration_milliseconds_bucket{service_name=~\".+-app\"}[$__rate_interval]))) / 1000",
          "legendFormat": "{{service_name}}",
          "refId": "B"
        }
