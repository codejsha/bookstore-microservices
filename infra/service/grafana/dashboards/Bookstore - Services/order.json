        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{service_name=~\"$service_name\"}[$__rate_interval]))",
          "refId": "A"
